{
  "namespace": "org.radarcns.active.healthconnect",
  "type": "record",
  "name": "HealthConnectExerciseSession",
  "doc": "Health Connect ExerciseSessionRecord. One record per exercise session.",
  "fields": [
    { "name": "time", "type": "double", "doc": "Start time of the exercise in UTC (s)." },
    { "name": "endTime", "type": "double", "doc": "End time of the exercise in UTC (s)." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the app, seconds since the Unix Epoch." },
    { "name": "timeZoneOffset", "type": ["null", "int"], "doc": "Offset from UTC of the local time at measurement time (s). Null if unknown.", "default": null },
    { "name": "exerciseType", "type": ["null", "string"], "doc": "Type of exercise (e.g. RUNNING, WALKING, BIKING, SWIMMING, YOGA). Null if unknown.", "default": null },
    { "name": "title", "type": ["null", "string"], "doc": "Title of the exercise session. Null if not set.", "default": null },
    { "name": "notes", "type": ["null", "string"], "doc": "Notes for the exercise session. Null if not set.", "default": null },
    { "name": "sourcePackageName", "type": ["null", "string"], "doc": "Package name of the app that wrote this record to Health Connect.", "default": null }
  ]
}
