{
  "namespace": "org.radarcns.active.healthconnect",
  "type": "record",
  "name": "HealthConnectSleepSession",
  "doc": "Health Connect SleepSessionRecord. One record per sleep session.",
  "fields": [
    { "name": "time", "type": "double", "doc": "Start time of the sleep session in UTC (s)." },
    { "name": "endTime", "type": "double", "doc": "End time of the sleep session in UTC (s)." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the app, seconds since the Unix Epoch." },
    { "name": "timeZoneOffset", "type": ["null", "int"], "doc": "Offset from UTC of the local time at measurement time (s). Null if unknown.", "default": null },
    { "name": "title", "type": ["null", "string"], "doc": "Optional title of the sleep session.", "default": null },
    { "name": "notes", "type": ["null", "string"], "doc": "Optional notes for the sleep session.", "default": null },
    { "name": "sourcePackageName", "type": ["null", "string"], "doc": "Package name of the app that wrote this record to Health Connect.", "default": null }
  ]
}
