{
  "namespace": "org.radarcns.connector.dexcom",
  "type": "record",
  "name": "DexcomAlert",
  "doc": "Alert event from Dexcom CGM API v3.",
  "fields": [
    {
      "name": "recordId",
      "type": "string",
      "doc": "Dexcom record UUID."
    },
    {
      "name": "time",
      "type": "double",
      "doc": "System time of the alert in UTC (s). Parsed from Dexcom ISO 8601 systemTime."
    },
    {
      "name": "displayTime",
      "type": ["null", "string"],
      "default": null,
      "doc": "Display time as ISO 8601. Receiver records may have no offset."
    },
    {
      "name": "alertName",
      "type": ["null", { "type": "enum", "name": "DexcomAlertName", "symbols": ["HIGH", "LOW", "RISE", "FALL", "OUT_OF_RANGE", "URGENT_LOW"", "URGENT_LOW_SOON", "NO_READINGS", "UNKNOWN"], "doc": "Dexcom alert name."}],
      "default": null,
      "doc": "Alert name (e.g. high, low, rise, fall, urgentLow)."
    },
    {
      "name": "alertState",
      "type": "string",
      "doc": "Alert state (e.g. activeAlarming, activeSnoozed, inactive)."
    },
    {
      "name": "displayDevice",
      "type": ["null", "string"],
      "default": null,
      "doc": "Display device type: iOS, Android, or receiver. Null if unknown."
    },
    {
      "name": "transmitterGeneration",
      "type": ["null", "string"],
      "default": null,
      "doc": "Transmitter generation (for example g6 or g7). Null if unknown."
    },
    {
      "name": "transmitterGenerationVariant",
      "type": ["null", "string"],
      "default": null,
      "doc": "Transmitter generation variant. Null if unknown."
    },
    {
      "name": "transmitterId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Hashed Dexcom transmitter identifier. Null if unknown."
    },
    {
      "name": "displayApp",
      "type": ["null", "string"],
      "default": null,
      "doc": "Display application name (for example G6, G7, or Follow). Null if unknown."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record (s). Not in Dexcom JSON."
    }
  ]
}