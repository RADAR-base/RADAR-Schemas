{
  "namespace": "org.radarcns.connector.dexcom",
  "type": "record",
  "name": "DexcomCalibration",
  "doc": "Calibration event from Dexcom CGM API v3. Dexcom ONE does not support the /calibrations endpoint and will return an empty array.",
  "fields": [
    {
      "name": "recordId",
      "type": "string",
      "doc": "Dexcom record UUID."
    },
    {
      "name": "time",
      "type": "double",
      "doc": "System time of the calibration in UTC (s). Parsed from Dexcom ISO 8601 systemTime."
    },
    {
      "name": "displayTime",
      "type": ["null", "string"],
      "default": null,
      "doc": "Display time as ISO 8601. May lack UTC offset on receiver-sourced records."
    },
    {
      "name": "unit",
      "type": ["null", "string"],
      "default": null,
      "doc": "Unit of value (mg/dL or mmol/L)."
    },
    {
      "name": "value",
      "type": ["null", "int"],
      "default": null,
      "doc": "This is a blood glucose value the user measured on a normal meter and typed in by hand."
    },
    {
      "name": "displayDevice",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "DexcomDisplayDevice",
          "doc": "Type of Dexcom display device.",
          "symbols": ["RECEIVER", "IOS", "ANDROID", "UNKNOWN"]
        }
      ],
      "default": null,
      "doc": "The type of display device the alert came from. Enum: "unknown" "receiver" "iOS" "android""
    }, 
    {
      "name": "transmitterId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Hashed Dexcom transmitter identifier. Null if unknown."
    },
    {
      "name": "transmitterTicks",
      "type": ["null", "long"],
      "default": null,
      "doc": "Seconds since transmitter initiation."
    },
    {
      "name": "transmitterGeneration",
      "type": ["null", "string"],
      "default": null,
      "doc": "Transmitter generation (for example g6 or g7). Null if unknown."
    },
    {
      "name": "transmitterGenerationVariant",
      "type": ["null", "string"],
      "default": null,
      "doc": "Transmitter generation variant. Null if unknown."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record (s). Not in Dexcom JSON."
    }
  ]
}
