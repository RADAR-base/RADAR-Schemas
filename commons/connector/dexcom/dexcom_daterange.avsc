{
  "namespace": "org.radarcns.connector.dexcom",
  "type": "record",
  "name": "DexcomDataRange",
  "doc": "Earliest and latest available times per data type from Dexcom API v3 /dataRange.",
  "fields": [
    {
      "name": "calibrations",
      "type": [
        "null",
        {
          "type": "record",
          "name": "DexcomDataRangeWindow",
          "fields": [
            {
              "name": "start",
              "type": {
                "type": "record",
                "name": "DexcomDataRangeMoment",
                "fields": [
                  { "name": "systemTime", "type": ["null", "double"], "default": null, "doc": "UTC epoch (s)." },
                  { "name": "displayTime", "type": ["null", "string"], "default": null }
                ]
              }
            },
            {
              "name": "end",
              "type": {
                "type": "record",
                "name": "DexcomDataRangeMomentEnd",
                "fields": [
                  { "name": "systemTime", "type": ["null", "double"], "default": null, "doc": "UTC epoch (s)." },
                  { "name": "displayTime", "type": ["null", "string"], "default": null }
                ]
              }
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "egvs",
      "type": [
        "null",
        {
          "type": "record",
          "name": "DexcomDataRangeWindowEgvs",
          "fields": [
            {
              "name": "start",
              "type": {
                "type": "record",
                "name": "DexcomDataRangeMomentEgvsStart",
                "fields": [
                  { "name": "systemTime", "type": ["null", "double"], "default": null },
                  { "name": "displayTime", "type": ["null", "string"], "default": null }
                ]
              }
            },
            {
              "name": "end",
              "type": {
                "type": "record",
                "name": "DexcomDataRangeMomentEgvsEnd",
                "fields": [
                  { "name": "systemTime", "type": ["null", "double"], "default": null },
                  { "name": "displayTime", "type": ["null", "string"], "default": null }
                ]
              }
            }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "events",
      "type": [
        "null",
        {
          "type": "record",
          "name": "DexcomDataRangeWindowEvents",
          "fields": [
            {
              "name": "start",
              "type": {
                "type": "record",
                "name": "DexcomDataRangeMomentEventsStart",
                "fields": [
                  { "name": "systemTime", "type": ["null", "double"], "default": null },
                  { "name": "displayTime", "type": ["null", "string"], "default": null }
                ]
              }
            },
            {
              "name": "end",
              "type": {
                "type": "record",
                "name": "DexcomDataRangeMomentEventsEnd",
                "fields": [
                  { "name": "systemTime", "type": ["null", "double"], "default": null },
                  { "name": "displayTime", "type": ["null", "string"], "default": null }
                ]
              }
            }
          ]
        }
      ],
      "default": null
    },
    { "name": "timeReceived", "type": "double", "doc": "Time the connector received this record (s). Not in Dexcom JSON." }
  ]
}