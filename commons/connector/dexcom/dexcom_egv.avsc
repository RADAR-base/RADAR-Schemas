{
  "namespace": "org.radarcns.connector.dexcom",
  "type": "record",
  "name": "DexcomEgv",
  "doc": "Estimated glucose value (EGV) from Dexcom CGM API v3.",
  "fields": [
    {
      "name": "recordId",
      "type": "string",
      "doc": "Dexcom record UUID."
    },
    {
      "name": "time",
      "type": "double",
      "doc": "System time of the EGV in UTC (s). Parsed from Dexcom ISO 8601 systemTime."
    },
    {
      "name": "displayTime",
      "type": ["null", "string"],
      "default": null,
      "doc": "Display time as ISO 8601 with offset when from mobile app."
    },
    {
      "name": "transmitterId",
      "type": "string",
      "doc": "A hashed and encrypted version of the unique identifier of the transmitter. This may be used to determine uniqueness of the transmitter or associate multiple records with the same transmitter, but it cannot be matched to the real transmitter identifier."
    }, 
    {
      "name": "transmitterTicks",
      "type": ["null", "long"],
      "default": null,
      "doc": "Seconds since transmitter initiation. Null if unknown."
    },
    {
      "name": "value",
      "type": ["null", "int"],
      "default": null,
      "doc": "39: Indicates that the value was calculated, and it was less than 40; the value 39 is used in calculations but is not explicitly displayed to end users 40 to 400: This is the measuring range of the Dexcom CGM. 401: Indicates that the value was calculated, and it was greater than 400; the value 401 is used in calculations but is not explicitly displayed to end users."
    },
    {
      "name": "status",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "DexcomEgvStatus",
          "doc": "Estimated glucose value status when the value is outside the measuring range.",
          "symbols": ["HIGH", "LOW", "UNKNOWN"]
        }
      ],
      "default": null,
      "doc": "Explanation of the estimated glucose value when outside the measuring range. High indicates a glucose value of more than 400 milligrams per decilitre. Low indicates a glucose value of less than 40 milligrams per decilitre."
    }, 
    {
      "name": "trend",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "DexcomEgvTrend",
          "doc": "General trend of estimated glucose value movement. Corresponds to trendRate.",
          "symbols": [
            "NONE",
            "DOUBLE_UP",
            "SINGLE_UP",
            "FORTY_FIVE_UP",
            "FLAT",
            "FORTY_FIVE_DOWN",
            "SINGLE_DOWN",
            "DOUBLE_DOWN",
            "NOT_COMPUTABLE",
            "RATE_OUT_OF_RANGE",
            "UNKNOWN"
          ]
        }
      ],
      "default": null,
      "doc": "General trend of estimated glucose value movement. Corresponds to trendRate. Double up is plus 3 to plus 8. Single up is plus 2 to less than plus 3. Forty-five up is plus 1 to less than plus 2. Flat is greater than minus 1 and less than plus 1. Forty-five down is greater than minus 2 to minus 1. Single down is greater than minus 3 to minus 2. Double down is greater than minus 8 to minus 3. None means no arrow. Not computable means the algorithm did not compute a trend. Rate out of range means the filtered rate was outside the arrow ranges."
    }, 
    {
      "name": "unit",
      "type": "string",
      "doc": "Unit of value. Dexcom always sends milligrams per decilitre."
    },
    {
      "name": "rateUnit",
      "type": "string",
      "doc": "Unit for trendRate. Dexcom always sends milligrams per decilitre per minute."
    },
    {
      "name": "displayDevice",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "DexcomDisplayDevice",
          "doc": "Type of Dexcom display device.",
          "symbols": ["RECEIVER", "IOS", "ANDROID", "UNKNOWN"]
        }
      ],
      "default": null,
      "doc": "The type of display device the estimated glucose value came from. Values include unknown, receiver, iOS, and android."
    }, 
    {
      "name": "transmitterGeneration",
      "type": {
        "type": "enum",
        "name": "DexcomTransmitterGeneration",
        "doc": "Generation of the transmitter associated with this upload.",
        "symbols": ["G6", "G6_PLUS", "G6_PRO", "G7", "UNKNOWN"]
      },
      "doc": "Generation of the transmitter associated with this upload."
    }, 
    {
      "name": "transmitterGenerationVariant",
      "type": {
        "type": "enum",
        "name": "DexcomTransmitterGenerationVariant",
        "doc": "Transmitter generation variant associated with this upload.",
        "symbols": ["D1_PLUS", "G6", "G7", "G7_15_DAY", "UNKNOWN"]
      },
      "doc": "Transmitter generation variant associated with this upload."
    }, 
    {
      "name": "displayApp",
      "type": ["null", "string"],
      "default": null,
      "doc": "Display application name (for example G6, G7, or Follow). Null if unknown."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record (s). Not in Dexcom JSON."
    }
  ]
}