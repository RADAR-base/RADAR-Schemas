{
  "namespace": "org.radarcns.connector.dexcom",
  "type": "record",
  "name": "DexcomEgv",
  "doc": "Estimated glucose value (EGV) from Dexcom CGM API v3.",
  "fields": [
    {
      "name": "recordId",
      "type": "string",
      "doc": "Dexcom record UUID."
    },
    {
      "name": "time",
      "type": "double",
      "doc": "System time of the EGV in UTC (s). Parsed from Dexcom ISO 8601 systemTime."
    },
    {
      "name": "displayTime",
      "type": ["null", "string"],
      "default": null,
      "doc": "Display time as ISO 8601 with offset when from mobile app."
    },
    {
      "name": "transmitterId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Hashed Dexcom transmitter identifier. Null if unknown."
    },
    {
      "name": "transmitterTicks",
      "type": ["null", "long"],
      "default": null,
      "doc": "Seconds since transmitter initiation. Null if unknown."
    },
    {
      "name": "value",
      "type": ["null", "int"],
      "default": null,
      "doc": "39: Indicates that the value was calculated, and it was less than 40; the value 39 is used in calculations but is not explicitly displayed to end users 40 to 400: This is the measuring range of the Dexcom CGM. 401: Indicates that the value was calculated, and it was greater than 400; the value 401 is used in calculations but is not explicitly displayed to end users."
    },
    {
      "name": "status",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "DexcomEgvStatus",
          "doc": "Estimated glucose value status when the value is outside the measuring range.",
          "symbols": ["HIGH", "LOW", "UNKNOWN"]
        }
      ],
      "default": null,
      "doc": "Explanation of EGV record; used when the value field is outside the measuring range. "high": indicates a glucose value of more than 400. "low": indicates a glucose value of less than 40. "
    }, 
    {
      "name": "trend",
      "type": ["null", "string"],
      "default": null,
      "doc": "Trend arrow (e.g. flat, singleUp)."
    },
    {
      "name": "trend",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "DexcomEgvTrend",
          "doc": "General trend of estimated glucose value movement. Corresponds to trendRate.",
          "symbols": [
            "NONE",
            "DOUBLE_UP",
            "SINGLE_UP",
            "FORTY_FIVE_UP",
            "FLAT",
            "FORTY_FIVE_DOWN",
            "SINGLE_DOWN",
            "DOUBLE_DOWN",
            "NOT_COMPUTABLE",
            "RATE_OUT_OF_RANGE",
            "UNKNOWN"
          ]
        }
      ],
      "default": null,
      "doc": ""doubleUp" (+3 ≤ trendRate ≤ +8), "singleUp" (+2 ≤ trendRate < +3), "fortyFiveUp" (+1 ≤ trendRate < +2), "flat" (-1 < trendRate < +1), "fortyFiveDown" (-2 < trendRate ≤ -1), "singleDown" (-3 < trendRate ≤ -2), "doubleDown" (-8 < trendRate ≤ -3), "none" (no arrow (blank)), "notComputable" (The algorithm decides that it is not reasonable to compute trend arrow), "rateOutOfRange" (The computed filtered rate is not within the range for assigning the arrows)"
    }, 
    {
      "name": "unit",
      "type": "string",
      "doc": "Unit of value (mg/dL or mmol/L). Dexcom always send mg/dL"
    },
    {
      "name": "rateUnit",
      "type": string,
      "default": null,
      "doc": "Unit for trendRate (e.g. mg/dL/min). Dexcom always send mg/dL"
    },
    {
      "name": "displayDevice",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "DexcomDisplayDevice",
          "doc": "Type of Dexcom display device.",
          "symbols": ["RECEIVER", "IOS", "ANDROID", "UNKNOWN"]
        }
      ],
      "default": null,
      "doc": "The type of display device the alert came from. Enum: "unknown" "receiver" "iOS" "android""
    }, 
    {
      "name": "transmitterGeneration",
      "type": {
        "type": "enum",
        "name": "DexcomTransmitterGeneration",
        "doc": "Generation of the transmitter associated with this upload.",
        "symbols": ["G6", "G6_PLUS", "G6_PRO", "G7", "UNKNOWN"]
      },
      "doc": "Generation of the transmitter associated with this upload."
    }, 
    {
      "name": "transmitterGenerationVariant",
      "type": ["null", "string"],
      "default": null,
      "doc": "Transmitter generation variant. Null if unknown."
    },
    {
      "name": "displayApp",
      "type": ["null", "string"],
      "default": null,
      "doc": "Display application name (for example G6, G7, or Follow). Null if unknown."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record (s). Not in Dexcom JSON."
    }
  ]
}