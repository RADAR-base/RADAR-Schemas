{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiActiveHours",
  "doc": "Huawei Health Kit REST data for com.huawei.active_hours. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "activeHours",
      "type": [
        "null",
        "int"
      ],
      "doc": "Value of Huawei field 'active_hours' for data type com.huawei.active_hours.",
      "default": null
    },
    {
      "name": "moderateIntensityMinutes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Value of Huawei field 'moderate_intensity_minutes' for data type com.huawei.active_hours.",
      "default": null
    },
    {
      "name": "highIntensityMinutes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Value of Huawei field 'high_intensity_minutes' for data type com.huawei.active_hours.",
      "default": null
    }
  ]
}
