{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiActiveHoursStatistics",
  "doc": "Aggregated statistics over a set of active-hour intervals, summarising moderate and high intensity activity minutes, as collected by the Huawei Health Kit active_hours.statistics data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "activeHours",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of hours with at least moderate-intensity activity.",
      "default": null
    }
  ]
}
