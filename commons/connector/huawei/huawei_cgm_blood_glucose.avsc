{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiCgmBloodGlucose",
  "doc": "A continuous glucose monitoring (CGM) blood glucose reading captured at a point in time by a CGM sensor, as collected by the Huawei Health Kit cgm_blood_glucose data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "level",
      "type": [
        "null",
        "double"
      ],
      "doc": "Continuous glucose monitoring (CGM) blood glucose level (mmol/L).",
      "default": null
    }
  ]
}
