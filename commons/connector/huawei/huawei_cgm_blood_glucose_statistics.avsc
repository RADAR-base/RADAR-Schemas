{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiCgmBloodGlucoseStatistics",
  "doc": "Aggregated statistics (average, maximum, minimum, most recent) for continuous glucose monitoring readings over a time interval, as collected by the Huawei Health Kit cgm_blood_glucose.statistics data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "avg",
      "type": [
        "null",
        "int"
      ],
      "doc": "Average CGM blood glucose over the period (mmol/L).",
      "default": null
    },
    {
      "name": "max",
      "type": [
        "null",
        "int"
      ],
      "doc": "Maximum CGM blood glucose over the period (mmol/L).",
      "default": null
    },
    {
      "name": "min",
      "type": [
        "null",
        "int"
      ],
      "doc": "Minimum CGM blood glucose over the period (mmol/L).",
      "default": null
    },
    {
      "name": "last",
      "type": [
        "null",
        "int"
      ],
      "doc": "Most recent CGM blood glucose value in the period (mmol/L).",
      "default": null
    }
  ]
}
