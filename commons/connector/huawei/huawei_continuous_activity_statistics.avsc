{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousActivityStatistics",
  "doc": "Huawei Health Kit REST data for com.huawei.continuous.activity.statistics. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "typeOfActivity",
      "type": [
        "null",
        "int"
      ],
      "doc": "Value of Huawei field 'type_of_activity' for data type com.huawei.continuous.activity.statistics.",
      "default": null
    },
    {
      "name": "span",
      "type": [
        "null",
        "int"
      ],
      "doc": "Value of Huawei field 'span' for data type com.huawei.continuous.activity.statistics.",
      "default": null
    },
    {
      "name": "fragments",
      "type": [
        "null",
        "int"
      ],
      "doc": "Value of Huawei field 'fragments' for data type com.huawei.continuous.activity.statistics.",
      "default": null
    }
  ]
}
