{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousAltitudeStatistics",
  "doc": "Aggregated altitude statistics (average, maximum, minimum) over a time interval derived from barometric or GPS data, as collected by the Huawei Health Kit continuous.altitude.statistics data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "avg",
      "type": [
        "null",
        "double"
      ],
      "doc": "Average value over the aggregation period.",
      "default": null
    },
    {
      "name": "max",
      "type": [
        "null",
        "double"
      ],
      "doc": "Maximum value over the aggregation period.",
      "default": null
    },
    {
      "name": "min",
      "type": [
        "null",
        "double"
      ],
      "doc": "Minimum value over the aggregation period.",
      "default": null
    },
    {
      "name": "ascentTotal",
      "type": [
        "null",
        "double"
      ],
      "doc": "Total ascent over the session (m).",
      "default": null
    },
    {
      "name": "descentTotal",
      "type": [
        "null",
        "double"
      ],
      "doc": "Total descent over the session (m).",
      "default": null
    }
  ]
}
