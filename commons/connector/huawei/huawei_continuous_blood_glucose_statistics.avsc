{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousBloodGlucoseStatistics",
  "doc": "Huawei Health Kit REST data for com.huawei.continuous.blood_glucose.statistics. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "avg",
      "type": [
        "null",
        "double"
      ],
      "doc": "Average value over the aggregation period.",
      "default": null
    },
    {
      "name": "max",
      "type": [
        "null",
        "double"
      ],
      "doc": "Maximum value over the aggregation period.",
      "default": null
    },
    {
      "name": "min",
      "type": [
        "null",
        "double"
      ],
      "doc": "Minimum value over the aggregation period.",
      "default": null
    },
    {
      "name": "correlationWithMealtime",
      "type": [
        "null",
        "int"
      ],
      "doc": "Relationship of the measurement to meals: 1=general, 2=fasting, 3=before meal, 4=after meal.",
      "default": null
    },
    {
      "name": "meal",
      "type": [
        "null",
        "int"
      ],
      "doc": "Meal type: 0=unknown, 1=breakfast, 2=lunch, 3=dinner, 4=snack.",
      "default": null
    },
    {
      "name": "correlationWithSleepState",
      "type": [
        "null",
        "int"
      ],
      "doc": "Relationship of the measurement to sleep state: 1=fully awake, 2=before sleep, 3=on waking, 4=during sleep.",
      "default": null
    },
    {
      "name": "sampleSource",
      "type": [
        "null",
        "int"
      ],
      "doc": "Blood sample source: 1=interstitial fluid, 2=capillary blood, 3=plasma, 4=serum, 5=tears, 6=whole blood.",
      "default": null
    }
  ]
}
