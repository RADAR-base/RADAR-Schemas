{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousCaloriesBurnt",
  "doc": "Active calorie expenditure over a continuous interval, excluding basal metabolism, as collected by the Huawei Health Kit continuous.calories.burnt data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "calories",
      "type": [
        "null",
        "double"
      ],
      "doc": "Energy expenditure (kcal).",
      "default": null
    }
  ]
}
