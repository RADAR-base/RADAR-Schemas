{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousCaloriesBurntTotal",
  "doc": "Huawei Health Kit REST data for com.huawei.continuous.calories.burnt.total. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "caloriesTotal",
      "type": [
        "null",
        "double"
      ],
      "doc": "Total energy expenditure (kcal).",
      "default": null
    }
  ]
}
