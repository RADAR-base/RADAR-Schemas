{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousCaloriesConsumed",
  "doc": "Caloric intake from food consumed during a continuous interval, optionally tagged by meal type, as collected by the Huawei Health Kit continuous.calories.consumed data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "calories",
      "type": [
        "null",
        "double"
      ],
      "doc": "Energy expenditure (kcal).",
      "default": null
    }
  ]
}
