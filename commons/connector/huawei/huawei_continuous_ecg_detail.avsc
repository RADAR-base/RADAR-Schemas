      "default": null
    },
    {
      "name": "ecgArrhythmiaType",
      "type": [
        "null",
        "int"
      ],
      "doc": "Value of Huawei field 'ecg_arrhythmia_type' for data type com.huawei.continuous.ecg_detail.",
      "default": null
    },
    {
      "name": "ecgArrhythmiaResult",
      "type": [
        "null",
        "int"
      ],
      "doc": "Value of Huawei field 'ecg_arrhythmia_result' for data type com.huawei.continuous.ecg_detail.",
      "default": null
    },
    {
      "name": "userSymptom",
      "type": [
        "null",
        "string"
      ],
      "doc": "Value of Huawei field 'user_symptom' for data type com.huawei.continuous.ecg_detail.",
      "default": null
