{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousExerciseIntensity",
  "doc": "Exercise intensity level recorded over a continuous interval, classifying effort into intensity zones, with optional aggregated duration, as collected by the Huawei Health Kit continuous.exercise_intensity and continuous.exercise_intensity.statistics data types.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "intensity",
      "type": [
        "null",
        "double"
      ],
      "doc": "Workout intensity.",
      "default": null
    },
    {
      "name": "span",
      "type": [
        "null",
        "int"
      ],
      "doc": "Duration of the segment (ms).",
      "default": null
    }
  ]
}
