{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousExerciseIntensityStatistics",
  "doc": "Aggregated exercise intensity statistics over a time window, as collected by the Huawei Health Kit continuous.exercise_intensity.statistics data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "intensity",
      "type": [
        "null",
        "double"
      ],
      "doc": "Workout intensity.",
      "default": null
    },
    {
      "name": "span",
      "type": [
        "null",
        "int"
      ],
      "doc": "Duration of the segment (ms).",
      "default": null
    }
  ]
}
