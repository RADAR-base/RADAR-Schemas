{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousExerciseIntensityV2",
  "doc": "Exercise intensity level (version 2) recorded over a continuous interval, with an extended intensity zone map, as collected by the Huawei Health Kit continuous.exercise_intensity.v2 data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "exerciseType",
      "type": [
        "null",
        "int"
      ],
      "doc": "Huawei exercise type identifier.",
      "default": null
    }
  ]
}
