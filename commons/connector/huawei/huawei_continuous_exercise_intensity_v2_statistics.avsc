{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousExerciseIntensityV2Statistics",
  "doc": "Huawei Health Kit REST data for com.huawei.continuous.exercise_intensity.v2.statistics. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "intensityMap",
      "type": [
        "null",
        "string"
      ],
      "doc": "Exercise intensity zone distribution stored as a JSON map.",
      "default": null
    }
  ]
}
