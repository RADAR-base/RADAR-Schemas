{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousMenstrualFlow",
  "doc": "Menstrual flow volume recorded over a continuous interval, as collected by the Huawei Health Kit continuous.menstrual_flow data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "volume",
      "type": [
        "null",
        "int"
      ],
      "doc": "Menstrual flow volume: 1=spotting, 2=light, 3=medium, 4=heavy.",
      "default": null
    }
  ]
}
