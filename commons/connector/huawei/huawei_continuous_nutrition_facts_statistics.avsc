{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousNutritionFactsStatistics",
  "doc": "Aggregated nutrition intake statistics (food, nutrients, meal type) over a time interval, as collected by the Huawei Health Kit continuous.nutrition_facts.statistics data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "nutrients",
      "type": [
        "null",
        "string"
      ],
      "doc": "Nutritional content stored as a JSON map.",
      "default": null
    },
    {
      "name": "meal",
      "type": [
        "null",
        "int"
      ],
      "doc": "Meal type: 0=unknown, 1=breakfast, 2=lunch, 3=dinner, 4=snack.",
      "default": null
    }
  ]
}
