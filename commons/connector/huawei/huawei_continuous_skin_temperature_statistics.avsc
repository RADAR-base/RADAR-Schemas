{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousSkinTemperatureStatistics",
  "doc": "Huawei Health Kit REST data for com.huawei.continuous.skin.temperature.statistics. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "avg",
      "type": [
        "null",
        "double"
      ],
      "doc": "Average value over the aggregation period.",
      "default": null
    },
    {
      "name": "max",
      "type": [
        "null",
        "double"
      ],
      "doc": "Maximum value over the aggregation period.",
      "default": null
    },
    {
      "name": "min",
      "type": [
        "null",
        "double"
      ],
      "doc": "Minimum value over the aggregation period.",
      "default": null
    }
  ]
}
