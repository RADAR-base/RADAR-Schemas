{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousSleepFragment",
  "doc": "A single sleep stage segment classified by sleep state (awake, REM, light, or deep sleep), as collected by the Huawei Health Kit continuous.sleep.fragment data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "sleepState",
      "type": [
        "null",
        "int"
      ],
      "doc": "Sleep stage: 1=awake, 2=REM, 3=light sleep, 4=deep sleep.",
      "default": null
    }
  ]
}
