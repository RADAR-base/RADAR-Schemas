{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousSpo2Statistics",
  "doc": "Huawei Health Kit REST data for com.huawei.continuous.spo2.statistics. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "saturationAvg",
      "type": [
        "null",
        "double"
      ],
      "doc": "Value of Huawei field 'saturation_avg' for data type com.huawei.continuous.spo2.statistics.",
      "default": null
    },
    {
      "name": "saturationMax",
      "type": [
        "null",
        "double"
      ],
      "doc": "Value of Huawei field 'saturation_max' for data type com.huawei.continuous.spo2.statistics.",
      "default": null
    },
    {
      "name": "saturationMin",
      "type": [
        "null",
        "double"
      ],
      "doc": "Value of Huawei field 'saturation_min' for data type com.huawei.continuous.spo2.statistics.",
      "default": null
    },
    {
      "name": "saturationLast",
      "type": [
        "null",
        "double"
      ],
      "doc": "Value of Huawei field 'saturation_last' for data type com.huawei.continuous.spo2.statistics.",
      "default": null
    }
  ]
}
