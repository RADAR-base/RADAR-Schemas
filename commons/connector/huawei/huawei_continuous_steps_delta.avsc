{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousStepsDelta",
  "doc": "Incremental step count since the previous reading, suitable for accumulating total steps over a period, as collected by the Huawei Health Kit continuous.steps.delta data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "stepsDelta",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of steps taken since the last reading.",
      "default": null
    }
  ]
}
