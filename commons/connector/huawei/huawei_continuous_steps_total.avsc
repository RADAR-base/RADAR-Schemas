{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiContinuousStepsTotal",
  "doc": "Cumulative step count over a continuous interval, as collected by the Huawei Health Kit continuous.steps.total data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "steps",
      "type": [
        "null",
        "int"
      ],
      "doc": "Step count.",
      "default": null
    },
    {
      "name": "duration",
      "type": [
        "null",
        "int"
      ],
      "doc": "Duration (ms).",
      "default": null
    }
  ]
}
