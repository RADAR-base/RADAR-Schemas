{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiDailyActivitySummary",
  "doc": "Huawei Health Kit REST data for com.huawei.daily_activity_summary. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "steps",
      "type": [
        "null",
        "int"
      ],
      "doc": "Step count.",
      "default": null
    },
    {
      "name": "activeCalories",
      "type": [
        "null",
        "int"
      ],
      "doc": "Active energy expenditure excluding basal metabolism (kcal).",
      "default": null
    },
    {
      "name": "exerciseTime",
      "type": [
        "null",
        "int"
      ],
      "doc": "Active exercise duration (ms).",
      "default": null
    },
    {
      "name": "activeHours",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of hours with at least moderate-intensity activity.",
      "default": null
    },
    {
      "name": "stepsGoal",
      "type": [
        "null",
        "int"
      ],
      "doc": "Daily step count goal.",
      "default": null
    },
    {
      "name": "activeCaloriesGoal",
      "type": [
        "null",
        "int"
      ],
      "doc": "Daily active calorie expenditure goal (kcal).",
      "default": null
    },
    {
      "name": "exerciseTimeGoal",
      "type": [
        "null",
        "int"
      ],
      "doc": "Daily exercise duration goal (ms).",
      "default": null
    },
    {
      "name": "activeHoursGoal",
      "type": [
        "null",
        "int"
      ],
      "doc": "Daily active hours goal.",
      "default": null
    }
  ]
}
