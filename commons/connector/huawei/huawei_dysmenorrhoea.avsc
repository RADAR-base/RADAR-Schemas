{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiDysmenorrhoea",
  "doc": "Dysmenorrhoea (menstrual pain) record capturing the self-reported pain level, as collected by the Huawei Health Kit dysmenorrhoea data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "level",
      "type": [
        "null",
        "int"
      ],
      "doc": "Dysmenorrhoea pain level.",
      "default": null
    }
  ]
}
