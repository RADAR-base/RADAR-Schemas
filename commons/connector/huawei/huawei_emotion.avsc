{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiEmotion",
  "doc": "Emotion or mood state detected by the device, as collected by the Huawei Health Kit emotion data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "emotionStatus",
      "type": [
        "null",
        "int"
      ],
      "doc": "Emotion status code detected by the device.",
      "default": null
    }
  ]
}
