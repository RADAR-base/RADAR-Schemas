{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiHealthRecordDynamicBp",
  "doc": "A 24-hour ambulatory blood pressure monitoring (ABPM) session record, containing aggregated systolic, diastolic, and pulse statistics for the full day, waking period, sleep period, and the 2 hours after waking, as collected by the Huawei Health Kit health.record.dynamic_bp data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "planId",
      "type": [
        "null",
        "string"
      ],
      "doc": "ABPM plan identifier.",
      "default": null
    },
    {
      "name": "planStartTime",
      "type": [
        "null",
        "long"
      ],
      "doc": "ABPM plan start time (ms since epoch).",
      "default": null
    },
    {
      "name": "planEndTime",
      "type": [
        "null",
        "long"
      ],
      "doc": "ABPM plan scheduled end time (ms since epoch).",
      "default": null
    },
    {
      "name": "planActualTime",
      "type": [
        "null",
        "long"
      ],
