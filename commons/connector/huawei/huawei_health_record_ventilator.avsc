{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiHealthRecordVentilator",
  "doc": "Huawei Health Kit REST data for com.huawei.health.record.ventilator. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "sysmode",
      "type": [
        "null",
        "int"
      ],
      "doc": "Ventilator operating mode code.",
      "default": null
    },
    {
      "name": "syssessiondate",
      "type": [
        "null",
        "long"
      ],
      "doc": "Unix timestamp (ms) of the ventilator session date.",
      "default": null
    },
    {
      "name": "eventahi",
      "type": [
        "null",
        "double"
      ],
      "doc": "Apnea-hypopnea index (AHI) for the session, measuring sleep-disordered breathing severity.",
      "default": null
    },
    {
      "name": "sysduration",
      "type": [
        "null",
        "int"
      ],
      "doc": "Duration of the ventilator session (s).",
      "default": null
    },
    {
      "name": "lumistidvolmedian",
      "type": [
        "null",
        "double"
      ],
      "doc": "Median tidal volume during the ventilator session (Lumis device).",
      "default": null
    },
    {
      "name": "lumistidvol95",
      "type": [
        "null",
        "double"
      ],
      "doc": "95th-percentile tidal volume during the ventilator session (Lumis device).",
      "default": null
    },
    {
      "name": "lumistidvolmax",
      "type": [
        "null",
        "double"
      ],
      "doc": "Maximum tidal volume during the ventilator session (Lumis device).",
      "default": null
    },
    {
      "name": "clinicalrespratemedian",
      "type": [
        "null",
        "double"
      ],
      "doc": "Median respiratory rate during the ventilator session (breaths/min).",
      "default": null
    },
    {
      "name": "clinicalresprate95",
      "type": [
        "null",
        "double"
      ],
      "doc": "95th-percentile respiratory rate during the ventilator session (breaths/min).",
      "default": null
    },
    {
      "name": "clinicalrespratemax",
      "type": [
        "null",
        "double"
      ],
      "doc": "Maximum respiratory rate during the ventilator session (breaths/min).",
      "default": null
    },
    {
      "name": "lumisieratiomedian",
      "type": [
        "null",
        "double"
      ],
      "doc": "Median inspiratory-to-expiratory (I:E) ratio during the ventilator session (Lumis device).",
      "default": null
    },
    {
      "name": "lumisieratioquantile95",
      "type": [
        "null",
        "double"
      ],
      "doc": "95th-percentile I:E ratio during the ventilator session (Lumis device).",
      "default": null
    },
    {
      "name": "lumisieratiomax",
      "type": [
        "null",
        "double"
      ],
      "doc": "Maximum I:E ratio during the ventilator session (Lumis device).",
      "default": null
    },
    {
      "name": "maskoff",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of mask-off events during the ventilator session.",
      "default": null
    },
    {
      "name": "hypoventilationindex",
      "type": [
        "null",
        "double"
      ],
      "doc": "Hypoventilation index for the ventilator session.",
      "default": null
    },
    {
      "name": "obstructiveapneaindex",
      "type": [
        "null",
        "double"
      ],
      "doc": "Obstructive apnea index for the ventilator session.",
      "default": null
    },
    {
      "name": "pressurebelow95",
      "type": [
        "null",
        "double"
      ],
      "doc": "Percentage of session time with pressure below the 95th-percentile threshold.",
      "default": null
    },
    {
      "name": "hypoventilationeventtimes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of hypoventilation events detected during the session.",
      "default": null
    },
    {
      "name": "snoringeventtimes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of snoring events detected during the session.",
      "default": null
    },
    {
      "name": "obstructiveapneaeventtimes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of obstructive apnea events detected during the session.",
      "default": null
    },
    {
      "name": "centerapneaeventtimes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of central apnea events detected during the session.",
      "default": null
    },
    {
      "name": "airflowlimiteventtimes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of airflow limitation events detected during the session.",
      "default": null
    },
    {
      "name": "massiveleakeventtimes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of large mask-leak events detected during the session.",
      "default": null
    },
    {
      "name": "unknoweventtimes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of unclassified respiratory events during the session.",
      "default": null
    },
    {
      "name": "alleventtimes",
      "type": [
        "null",
        "int"
      ],
      "doc": "Total number of respiratory events during the ventilator session.",
      "default": null
    }
  ]
}
