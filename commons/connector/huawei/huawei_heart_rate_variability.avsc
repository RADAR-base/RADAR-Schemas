{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiHeartRateVariability",
  "doc": "Huawei Health Kit REST data for com.huawei.heart_rate_variability. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "heartRateVariabilityRmssd",
      "type": [
        "null",
        "int"
      ],
      "doc": "Heart rate variability measured as RMSSD (root mean square of successive differences between adjacent RR intervals, ms).",
      "default": null
    }
  ]
}
