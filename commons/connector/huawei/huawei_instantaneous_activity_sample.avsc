{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousActivitySample",
  "doc": "A single instantaneous physical activity detection sample with the activity type and detection confidence, as collected by the Huawei Health Kit instantaneous.activity.sample data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "typeOfActivity",
      "type": [
        "null",
        "int"
      ],
      "doc": "Detected activity type identifier (Huawei activity constant, e.g. 0=unknown, 3=walking, 4=running, 8=cycling).",
      "default": null
    },
    {
      "name": "possibility",
      "type": [
        "null",
        "double"
      ],
      "doc": "Confidence of the activity type detection, ranging from 0.0 to 100.0.",
      "default": null
    }
  ]
}
