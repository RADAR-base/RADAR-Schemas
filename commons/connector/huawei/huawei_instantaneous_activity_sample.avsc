{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousActivitySample",
  "doc": "A single instantaneous physical activity detection sample, including the detected activity type and confidence, as collected by the Huawei Health Kit instantaneous.activity.sample data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "possibility",
      "type": [
        "null",
        "double"
      ],
      "doc": "Confidence of the activity type detection, ranging from 0.0 to 100.0.",
      "default": null
    }
  ]
}
