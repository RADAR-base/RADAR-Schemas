{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousAltitude",
  "doc": "A single instantaneous altitude measurement derived from barometric pressure or GPS, as collected by the Huawei Health Kit instantaneous.altitude data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "altitude",
      "type": [
        "null",
        "double"
      ],
      "doc": "Altitude above sea level (m).",
      "default": null
    }
  ]
}
