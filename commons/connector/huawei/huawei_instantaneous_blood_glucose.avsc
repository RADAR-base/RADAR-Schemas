{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousBloodGlucose",
  "doc": "Huawei Health Kit REST data for com.huawei.instantaneous.blood_glucose. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "level",
      "type": [
        "null",
        "double"
      ],
      "doc": "Blood glucose level (mmol/L).",
      "default": null
    },
    {
      "name": "measureTime",
      "type": [
        "null",
        "int"
      ],
      "doc": "Timing of measurement relative to meals: 1=before breakfast, 2=after breakfast, 3=before lunch, 4=after lunch, 5=before dinner, 6=after dinner, 7=before sleep, 8=before dawn, 9=random.",
      "default": null
    },
    {
      "name": "sampleSource",
      "type": [
        "null",
        "int"
      ],
      "doc": "Blood sample source: 1=interstitial fluid, 2=capillary blood, 3=plasma, 4=serum, 5=tears, 6=whole blood.",
      "default": null
    }
  ]
}
