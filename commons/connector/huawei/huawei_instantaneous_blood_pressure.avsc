{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousBloodPressure",
  "doc": "A single blood pressure measurement including systolic and diastolic pressures, body posture, measurement site, pulse rate, and any anomaly flag, as collected by the Huawei Health Kit instantaneous.blood_pressure data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "systolicPressure",
      "type": [
        "null",
        "double"
      ],
      "doc": "Systolic blood pressure (mmHg).",
      "default": null
    },
    {
      "name": "diastolicPressure",
      "type": [
        "null",
        "double"
      ],
      "doc": "Diastolic blood pressure (mmHg).",
      "default": null
    },
    {
      "name": "bodyPosture",
      "type": [
        "null",
        "int"
      ],
      "doc": "Body posture during measurement: 1=standing, 2=sitting, 3=lying down, 4=semi-recumbent.",
      "default": null
    },
    {
      "name": "measureBodyPartOfBloodPressure",
      "type": [
        "null",
        "float"
      ],
      "doc": "Body part where blood pressure was measured: 1=left wrist, 2=right wrist, 3=left upper arm, 4=right upper arm.",
      "default": null
    },
    {
      "name": "sphygmus",
      "type": [
        "null",
        "double"
      ],
      "doc": "Pulse rate (bpm).",
      "default": null
    },
    {
      "name": "measurementAnomalyFlag",
      "type": [
        "null",
        "int"
      ],
      "doc": "Flag indicating a measurement anomaly (0=normal, non-zero=anomalous).",
      "default": null
    },
    {
      "name": "beforeMeasureActivity",
      "type": [
        "null",
        "int"
      ],
      "doc": "Activity performed before the measurement.",
      "default": null
    }
  ]
}
