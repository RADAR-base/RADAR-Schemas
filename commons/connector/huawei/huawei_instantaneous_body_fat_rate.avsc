{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousBodyFatRate",
  "doc": "A single body fat percentage measurement, as collected by the Huawei Health Kit instantaneous.body.fat.rate data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "bodyFatRate",
      "type": [
        "null",
        "double"
      ],
      "doc": "Body fat percentage (%), ranging from 0 to 100.",
      "default": null
    }
  ]
}
