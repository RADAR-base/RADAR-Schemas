{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousBodyFatRate",
  "doc": "Huawei Health Kit REST data for com.huawei.instantaneous.body.fat.rate. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "bodyFatRate",
      "type": [
        "null",
        "double"
      ],
      "doc": "Body fat percentage (%), ranging from 0 to 100.",
      "default": null
    }
  ]
}
