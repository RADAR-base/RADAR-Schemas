{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousBodyTemperatureRest",
  "doc": "Huawei Health Kit REST data for com.huawei.instantaneous.body.temperature.rest. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "temperature",
      "type": [
        "null",
        "double"
      ],
      "doc": "Body temperature (°C).",
      "default": null
    },
    {
      "name": "measureBodyPartOfTemperature",
      "type": [
        "null",
        "int"
      ],
      "doc": "Body site for temperature measurement: 1=axillary, 2=finger, 3=forehead, 4=oral, 5=rectal, 6=temporal artery, 7=toe, 8=tympanic, 9=wrist, 10=vaginal.",
      "default": null
    }
  ]
}
