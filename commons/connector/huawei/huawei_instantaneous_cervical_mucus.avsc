{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousCervicalMucus",
  "doc": "A single cervical mucus observation recording texture and amount, used in fertility tracking, as collected by the Huawei Health Kit instantaneous.cervical_mucus data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "texture",
      "type": [
        "null",
        "int"
      ],
      "doc": "Cervical mucus texture: 1=dry, 2=sticky, 3=creamy, 4=watery, 5=egg white.",
      "default": null
    },
    {
      "name": "amount",
      "type": [
        "null",
        "int"
      ],
      "doc": "Cervical mucus amount: 1=light, 2=medium, 3=heavy.",
      "default": null
    }
  ]
}
