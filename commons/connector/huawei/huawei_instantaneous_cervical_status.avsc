{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousCervicalStatus",
  "doc": "Huawei Health Kit REST data for com.huawei.instantaneous.cervical_status. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "position",
      "type": [
        "null",
        "int"
      ],
      "doc": "Cervical position: 1=low, 2=medium, 3=high.",
      "default": null
    },
    {
      "name": "dilationStatus",
      "type": [
        "null",
        "int"
      ],
      "doc": "Cervical dilation status: 1=closed, 2=medium, 3=open.",
      "default": null
    },
    {
      "name": "firmnessLevel",
      "type": [
        "null",
        "int"
      ],
      "doc": "Cervical firmness: 1=soft, 2=medium, 3=firm.",
      "default": null
    }
  ]
}
