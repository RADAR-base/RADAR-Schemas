{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousCervicalStatus",
  "doc": "A single cervical status observation recording position, dilation status, and firmness, used in fertility tracking, as collected by the Huawei Health Kit instantaneous.cervical_status data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "position",
      "type": [
        "null",
        "int"
      ],
      "doc": "Cervical position: 1=low, 2=medium, 3=high.",
      "default": null
    },
    {
      "name": "dilationStatus",
      "type": [
        "null",
        "int"
      ],
      "doc": "Cervical dilation status: 1=closed, 2=medium, 3=open.",
      "default": null
    },
    {
      "name": "firmnessLevel",
      "type": [
        "null",
        "int"
      ],
      "doc": "Cervical firmness: 1=soft, 2=medium, 3=firm.",
      "default": null
    }
  ]
}
