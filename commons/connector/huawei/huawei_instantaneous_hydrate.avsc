{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousHydrate",
  "doc": "A single water intake record capturing the volume consumed, as collected by the Huawei Health Kit instantaneous.hydrate data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "hydrate",
      "type": [
        "null",
        "double"
      ],
      "doc": "Water consumed (L).",
      "default": null
    }
  ]
}
