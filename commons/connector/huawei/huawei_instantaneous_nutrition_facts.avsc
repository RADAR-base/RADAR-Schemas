{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousNutritionFacts",
  "doc": "Huawei Health Kit REST data for com.huawei.instantaneous.nutrition_facts. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "nutrientsFacts",
      "type": [
        "null",
        "string"
      ],
      "doc": "Detailed nutrition facts stored as a JSON map.",
      "default": null
    },
    {
      "name": "meal",
      "type": [
        "null",
        "int"
      ],
      "doc": "Meal type: 0=unknown, 1=breakfast, 2=lunch, 3=dinner, 4=snack.",
      "default": null
    },
    {
      "name": "food",
      "type": [
        "null",
        "string"
      ],
      "doc": "Food type name.",
      "default": null
    }
  ]
}
