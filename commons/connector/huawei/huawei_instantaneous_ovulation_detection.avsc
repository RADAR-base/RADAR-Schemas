{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousOvulationDetection",
  "doc": "A single ovulation test result (positive or negative) from an ovulation predictor kit, as collected by the Huawei Health Kit instantaneous.ovulation_detection data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "detectionResult",
      "type": [
        "null",
        "int"
      ],
      "doc": "Ovulation detection result: 1=negative, 2=positive.",
      "default": null
    }
  ]
}
