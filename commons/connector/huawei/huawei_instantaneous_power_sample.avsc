{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousPowerSample",
  "doc": "A single instantaneous power output sample during exercise, measured in watts, as collected by the Huawei Health Kit instantaneous.power.sample data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "power",
      "type": [
        "null",
        "double"
      ],
      "doc": "Power output (W).",
      "default": null
    }
  ]
}
