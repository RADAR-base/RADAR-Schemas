{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousSkinTemperature",
  "doc": "A single skin surface temperature measurement at a specified body site, as collected by the Huawei Health Kit instantaneous.skin.temperature data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "temperature",
      "type": [
        "null",
        "double"
      ],
      "doc": "Body temperature (\u00b0C).",
      "default": null
    },
    {
      "name": "measureBodyPartOfTemperature",
      "type": [
        "null",
        "int"
      ],
      "doc": "Body site for temperature measurement: 1=axillary, 2=finger, 3=forehead, 4=oral, 5=rectal, 6=temporal artery, 7=toe, 8=tympanic, 9=wrist, 10=vaginal.",
      "default": null
    }
  ]
}
