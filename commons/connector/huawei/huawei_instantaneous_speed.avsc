{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousSpeed",
  "doc": "A single instantaneous movement speed measurement in metres per second, as collected by the Huawei Health Kit instantaneous.speed data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "speed",
      "type": [
        "null",
        "double"
      ],
      "doc": "Speed (m/s).",
      "default": null
    }
  ]
}
