{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousSpo2",
  "doc": "A single blood oxygen saturation (SpO2) measurement including oxygen therapy context and measurement method, as collected by the Huawei Health Kit instantaneous.spo2 data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "saturation",
      "type": [
        "null",
        "double"
      ],
      "doc": "Blood oxygen saturation (SpO2, %).",
      "default": null
    },
    {
      "name": "oxygenSupplyFlowRate",
      "type": [
        "null",
        "double"
      ],
      "doc": "Oxygen therapy supply flow rate (L/min).",
      "default": null
    },
    {
      "name": "oxygenTherapy",
      "type": [
        "null",
        "int"
      ],
      "doc": "Oxygen therapy delivery method: 1=nasal cannula.",
      "default": null
    },
    {
      "name": "spo2MeasurementMechanism",
      "type": [
        "null",
        "int"
      ],
      "doc": "SpO2 measurement mechanism: 1=peripheral capillary.",
      "default": null
    },
    {
      "name": "spo2MeasurementApproach",
      "type": [
        "null",
        "int"
      ],
      "doc": "SpO2 measurement approach: 1=pulse oximetry.",
      "default": null
    }
  ]
}
