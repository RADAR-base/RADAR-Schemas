{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousStressStatistics",
  "doc": "Huawei Health Kit REST data for com.huawei.instantaneous.stress.statistics. See Huawei HMS Core Health Kit RESTful data type documentation.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "avg",
      "type": [
        "null",
        "int"
      ],
      "doc": "Average stress score, ranging from 1 to 99.",
      "default": null
    },
    {
      "name": "max",
      "type": [
        "null",
        "int"
      ],
      "doc": "Highest stress score, ranging from 1 to 99.",
      "default": null
    },
    {
      "name": "min",
      "type": [
        "null",
        "int"
      ],
      "doc": "Lowest stress score, ranging from 1 to 99.",
      "default": null
    },
    {
      "name": "last",
      "type": [
        "null",
        "int"
      ],
      "doc": "Most recent stress score, ranging from 1 to 99.",
      "default": null
    },
    {
      "name": "measureCount",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of stress measurements taken.",
      "default": null
    }
  ]
}
