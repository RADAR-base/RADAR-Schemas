{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousUricAcid",
  "doc": "A single uric acid concentration measurement from a urine routine test, as collected by the Huawei Health Kit instantaneous.uric_acid data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "uricAcid",
      "type": [
        "null",
        "int"
      ],
      "doc": "Uric acid concentration in the urine routine test result.",
      "default": null
    }
  ]
}
