{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiInstantaneousVaginalSpeckle",
  "doc": "A single vaginal discharge (speckle) observation recording the number of occurrences, used in fertility and reproductive health tracking, as collected by the Huawei Health Kit instantaneous.vaginal_speckle data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "appearance",
      "type": [
        "null",
        "int"
      ],
      "doc": "Number of occurrences within the time period.",
      "default": null
    }
  ]
}
