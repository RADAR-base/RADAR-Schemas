{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiPhysicalSymptoms",
  "doc": "Physical symptoms reported by the user, stored as a structured string, used in reproductive health tracking, as collected by the Huawei Health Kit physical_symptoms data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "endTime",
      "type": [
        "null",
        "double"
      ],
      "doc": "End time of the sample or record in UTC (s), when provided by Huawei.",
      "default": null
    },
    {
      "name": "physicalsymptoms",
      "type": [
        "null",
        "string"
      ],
      "doc": "Physical symptoms reported by the user, stored as a structured string.",
      "default": null
    }
  ]
}
