{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiSleepOnOffBedRecord",
  "doc": "A record of the user getting into or out of bed during a sleep period, as collected by the Huawei Health Kit sleep.on_off_bed_record data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "onOffBedState",
      "type": [
        "null",
        "int"
      ],
      "doc": "Bed occupancy state: indicates whether the user is in or out of bed.",
      "default": null
    }
  ]
}
