{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiSpo2",
  "doc": "Single blood oxygen saturation (SpO2) reading as collected by the Huawei Health Kit instantaneous.spo2 data type.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "saturation",
      "type": [
        "null",
        "float"
      ],
      "doc": "Blood oxygen saturation (%).",
      "default": null
    },
    {
      "name": "oxygenSupplyFlowRate",
      "type": [
        "null",
        "float"
      ],
      "doc": "Flow rate of supplemental oxygen during the reading (L/min), 0 when no oxygen is supplied.",
      "default": null
    }
  ]
}
