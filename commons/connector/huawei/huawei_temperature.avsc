{
  "namespace": "org.radarcns.connector.huawei",
  "type": "record",
  "name": "HuaweiTemperature",
  "doc": "Single instantaneous temperature reading as collected by the Huawei Health Kit instantaneous.body.temperature and instantaneous.skin.temperature data types.",
  "fields": [
    {
      "name": "time",
      "type": "double",
      "doc": "Start time of the sample or record in UTC (s)."
    },
    {
      "name": "timeReceived",
      "type": "double",
      "doc": "Time the connector received this record from the Huawei Health API (s)."
    },
    {
      "name": "temperature",
      "type": [
        "null",
        "float"
      ],
      "doc": "Temperature reading (°C).",
      "default": null
    }
  ]
}
