{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthDailyRestingHeartRate",
  "doc": "Google Health daily resting heart rate for a user, calculated using the all day heart rate measurements.",
  "fields": [
    { "name": "date", "type": "string", "doc": "Local date of the user, formatted yyyy-MM-dd." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the push endpoint, seconds since the Unix Epoch." },
    { "name": "restingHeartRate", "type": "int", "doc": "Resting heart rate for the day, in beats per minute." },
    { "name": "time", "type": ["null", "double"], "doc": "Midnight at the start of the local date, written as if it were UTC, in seconds since January 1, 1970, 00:00:00 UTC. It is not the true instant, because Google Health gives only the local date. It marks the day for tools that need a numeric time, such as sink connectors.", "default": null }
  ]
}
