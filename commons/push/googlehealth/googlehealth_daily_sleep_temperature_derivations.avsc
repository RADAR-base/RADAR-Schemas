{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthDailySleepTemperatureDerivations",
  "doc": "Google Health derived sleep temperature values, calculated from skin or internal device temperature readings during sleep.",
  "fields": [
    { "name": "time", "type": ["null", "double"], "doc": "Midnight at the start of the local date, written as if it were UTC, in seconds since January 1, 1970, 00:00:00 UTC. It is not the true instant, because Google Health gives only the local date. It marks the day for tools that need a numeric time, such as sink connectors.", "default": null },
    { "name": "date", "type": "string", "doc": "Local date of the user (yyyy-MM-dd) for which the sleep temperature derivations are calculated." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the push endpoint, seconds since the Unix Epoch." },
    { "name": "relativeTemperature", "type": "float", "doc": "Nightly temperature relative to the user's baseline, in degrees Celsius (nightlyTemperatureCelsius - baselineTemperatureCelsius)." }
  ]
}
