{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthExercise",
  "doc": "Google Health `exercise` data points. A Session type: one record per recorded exercise/activity. Per-trackpoint GPS and sensor data is exported separately as GoogleHealthExerciseTcx.",
  "fields": [
    { "name": "time", "type": "double", "doc": "Session start time, seconds since the Unix Epoch (from exercise.interval start)." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the connector, seconds since the Unix Epoch." },
    { "name": "timeZoneOffset", "type": "int", "doc": "UTC offset of the user's timezone at session start, in seconds (from interval.startUtcOffset)." },
    { "name": "timeLastModified", "type": "double", "doc": "Session end time, seconds since the Unix Epoch (from exercise.interval end)." },
    { "name": "duration", "type": "float", "doc": "Session duration in seconds (end - start)." },
    { "name": "durationActive", "type": "float", "doc": "Active duration in seconds; equal to duration for Google sessions." },
    { "name": "id", "type": "long", "doc": "Exercise (log) id; the last path segment of the data point's dataPointName." },
    { "name": "name", "type": ["null", "string"], "doc": "Activity name, from displayName (falls back to exerciseType). Null if unknown.", "default": null },
    { "name": "logType", "type": ["null", "string"], "doc": "How the session was recorded, from dataSource.recordingMethod. Null if unknown.", "default": null },
    { "name": "type", "type": ["null", "long"], "doc": "Not provided by the Google Health API; always null.", "default": null },
    { "name": "source", "type": ["null", "GoogleHealthSource"], "doc": "Not provided by the Google Health API; always null.", "default": null },
    { "name": "manualDataEntry", "type": ["null", "GoogleHealthManualDataEntry"], "doc": "Not provided by the Google Health API; always null.", "default": null },
    { "name": "energy", "type": ["null", "float"], "doc": "Energy expended during the session in kilojoules (from metricsSummary.caloriesKcal). Null if unknown.", "default": null },
    { "name": "levels", "type": ["null", "GoogleHealthExerciseLevels"], "doc": "Not provided by the Google Health API; always null.", "default": null },
    { "name": "heartRate", "type": ["null", "GoogleHealthExerciseHeartRate"], "doc": "Aggregate heart rate over the session; only the mean is populated. Null if unknown.", "default": null },
    { "name": "steps", "type": ["null", "int"], "doc": "Steps taken during the session (from metricsSummary.steps). Null if unknown.", "default": null },
    { "name": "distance", "type": ["null", "float"], "doc": "Distance covered during the session in kilometres (from metricsSummary.distanceMillimeters). Null if unknown.", "default": null },
    { "name": "speed", "type": ["null", "double"], "doc": "Not provided by the Google Health API; always null.", "default": null }
  ]
}
