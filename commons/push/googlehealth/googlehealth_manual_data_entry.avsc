{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthManualDataEntry",
  "doc": "Flags indicating which exercise fields were entered manually. Not populated by the Google Health integration; always null on the exercise record. Retained for schema continuity.",
  "fields": [
    { "name": "distance", "type": ["null", "boolean"], "doc": "Whether the distance was entered manually. Null if unknown.", "default": null },
    { "name": "energy", "type": ["null", "boolean"], "doc": "Whether the energy was entered manually. Null if unknown.", "default": null },
    { "name": "steps", "type": ["null", "boolean"], "doc": "Whether the steps were entered manually. Null if unknown.", "default": null }
  ]
}
