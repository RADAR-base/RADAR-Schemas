{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthSleepClassic",
  "doc": "Google Health sleep data for CLASSIC sessions. One record per sleep level (ASLEEP, RESTLESS, AWAKE).",
  "fields": [
    { "name": "dateTime", "type": "string", "doc": "ISO 6801 formatted local date time of device (yyyy-MM-ddTHH:mm:ss)." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the connector, seconds since the Unix Epoch." },
    { "name": "duration", "type": "int", "doc": "Duration of this sleep level in seconds." },
      {
          "name": "level",
          "type": {
              "name": "GoogleHealthSleepClassicLevel",
              "type": "enum",
              "symbols": [
                  "AWAKE",
                  "RESTLESS",
                  "ASLEEP",
                  "UNKNOWN"
              ],
              "doc": "Classic sleep level, from stages[].type."
          },
          "doc": "Classic sleep level, from stages[].type.",
          "default": "UNKNOWN"
      }
  ]
}
