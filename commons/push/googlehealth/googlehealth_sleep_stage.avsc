{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthSleepStage",
  "doc": "Google Health sleep data for STAGES sessions. One record per sleep stage (DEEP, LIGHT, REM, AWAKE).",
  "fields": [
    { "name": "time", "type": ["null", "double"], "doc": "Start time of this sleep stage in seconds since January 1, 1970, 00:00:00 UTC (Unix timestamp).", "default": null },
    { "name": "dateTime", "type": "string", "doc": "ISO 6801 formatted local date time of device (yyyy-MM-ddTHH:mm:ss)." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the connector, seconds since the Unix Epoch." },
    { "name": "duration", "type": "int", "doc": "Duration of this stage in seconds." },
      {
          "name": "level",
          "type": {
              "name": "GoogleHealthSleepStageLevel",
              "type": "enum",
              "symbols": [
                  "DEEP",
                  "LIGHT",
                  "REM",
                  "AWAKE",
                  "UNKNOWN"
              ],
              "doc": "Level of sleep as computed by device."
          },
          "doc": "Level of sleep as computed by device.",
          "default": "UNKNOWN"
      },
    { "name": "utcOffset", "type": ["null", "int"], "doc": "Offset of the local time of the device from UTC at the start of this sleep stage, in seconds. Adding it to time gives the local time in dateTime.", "default": null }
  ]
}
