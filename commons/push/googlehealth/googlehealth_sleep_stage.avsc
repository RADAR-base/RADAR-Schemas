{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthSleepStage",
  "doc": "Google Health `sleep` data for STAGES sessions (devices with a heart-rate sensor). One record per sleep stage (DEEP, LIGHT, REM, AWAKE).",
  "fields": [
    { "name": "dateTime", "type": "string", "doc": "Local start time of the stage, ISO-8601 yyyy-MM-ddTHH:mm:ss (from stages[].startTime)." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the connector, seconds since the Unix Epoch." },
    { "name": "duration", "type": "int", "doc": "Duration of this stage in seconds (endTime - startTime)." },
    { "name": "level", "type": {"name": "GoogleHealthSleepStageLevel", "type": "enum", "symbols": ["DEEP", "LIGHT", "REM", "AWAKE", "UNKNOWN"], "doc": "Sleep stage, from stages[].type."}, "doc": "Sleep stage, from stages[].type.", "default": "UNKNOWN" },
    { "name": "efficiency", "type": ["null", "int"], "doc": "Not provided by the Google Health API; always null. Retained for schema continuity.", "default": null }
  ]
}
