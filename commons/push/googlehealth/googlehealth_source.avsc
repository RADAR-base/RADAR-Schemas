{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthSource",
  "doc": "The device and platform that recorded a data point, from its dataSource.",
  "fields": [
    { "name": "name", "type": ["null", "string"], "doc": "Device display name. Null if unknown.", "default": null },
    { "name": "formFactor", "type": ["null", "string"], "doc": "Device form factor, e.g. WATCH or PHONE. Null if unknown.", "default": null },
    { "name": "manufacturer", "type": ["null", "string"], "doc": "Device manufacture, null if unknown.", "default": null },
    { "name": "platform", "type": ["null", "string"], "doc": "Platform that uploaded the data, e.g. FITBIT. Null if unknown.", "default": null }
  ]
}
