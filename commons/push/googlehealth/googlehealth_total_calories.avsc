{
  "namespace": "org.radarcns.push.googlehealth",
  "type": "record",
  "name": "GoogleHealthTotalCalories",
  "doc": "Google Health `total-calories` data, aggregated per window via the rollUp endpoint.",
  "fields": [
    { "name": "time", "type": "double", "doc": "Start of the aggregation window, seconds since the Unix Epoch." },
    { "name": "timeReceived", "type": "double", "doc": "Time this record was collected by the connector, seconds since the Unix Epoch." },
    { "name": "timeInterval", "type": "int", "doc": "Length of the aggregation window in seconds." },
    { "name": "calories", "type": "double", "doc": "Total calories burned in the window, in kilocalories (from totalCalories.kcalSum)." },
    { "name": "level", "type": "int", "doc": "Not provided by the Google Health API; always 0. Retained for schema continuity." },
    { "name": "mets", "type": "double", "doc": "Not provided by the Google Health API; always 0. Retained for schema continuity." }
  ]
}
